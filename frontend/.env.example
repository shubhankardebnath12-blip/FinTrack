# ==============================================================
# FinTrack Frontend — Environment Variables
# ==============================================================
# Copy this file to .env.local for local development
# Set these in the Vercel dashboard for production

# Backend API URL
# Local dev:      http://localhost:5001/api
# Production:     https://your-render-app.onrender.com/api
VITE_API_URL=http://localhost:5001/api

# App metadata (optional, used in meta tags)
VITE_APP_NAME=FinTrack
VITE_APP_VERSION=1.0.0
