# ==============================================================
# FinTrack Backend — Environment Variables
# ==============================================================
# Copy this file to .env for local development
# Set these as Environment Variables in the Render dashboard

# Server
PORT=5001
NODE_ENV=production

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_user:your_password@your_cluster.mongodb.net/fintrack?retryWrites=true&w=majority

# JWT
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_64_char_random_hex_secret_here
JWT_EXPIRES_IN=7d

# Frontend origin (for CORS allow-list)
# Local dev:   http://localhost:5173
# Production:  https://your-vercel-app.vercel.app
FRONTEND_URL=https://your-vercel-app.vercel.app
